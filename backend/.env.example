# Copy this file to backend/.env and replace the example password and secret.
SAFEAGRI_OWNER_EMAIL=owner@safeagri.local
SAFEAGRI_OWNER_PASSWORD=change-this-to-your-own-password-123
SAFEAGRI_OWNER_NAME=Project Owner
SAFEAGRI_FARM_NAME=Kafubu Demonstration Farm
SAFEAGRI_FARM_LOCATION=Kafubu Block, Luanshya

# Generate a private key once and keep it unchanged between restarts.
SAFEAGRI_SECRET_KEY=replace-this-with-a-long-random-secret-value
